# Optional docker compose overrides for local deployment.
PANEL_PUBLIC_URL=http://your-node-or-domain:18080
# Public subscription hostname; falls back to PANEL_PUBLIC_URL when empty.
PANEL_SUBSCRIPTION_PUBLIC_URL=https://sub.xray.zrhe2016.cc
PANEL_USERNAME=
PANEL_PASSWORD=
PANEL_SECRET_KEY=
# Structured application logs. Fluent Bit forwards stdout/stderr to Loki.
PANEL_LOG_LEVEL=INFO
PANEL_SLOW_REQUEST_MS=1000
AI_ROUTING_ENABLED=1
# Direct private-network SSH management target. No private key is injected by the panel.
DATAPLANE_SSH_TARGET=root@100.116.187.106
DATAPLANE_SSH_OPTIONS=
DATAPLANE_SSH_KNOWN_HOSTS=/root/.ssh/known_hosts
DATAPLANE_REMOTE_COMMAND_TIMEOUT=8
DATAPLANE_API_SERVER=127.0.0.1:10085
DATAPLANE_CONFIG_PATH=
DATAPLANE_DYNAMIC_ROUTING_PATH=
DATAPLANE_AI_REPORT_PATH=
DATAPLANE_PANEL_DB_PATH=
DATAPLANE_PANEL_PORTS_PATH=
# Remote AI-domain analysis reads this path over SSH. If blank and
# DATAPLANE_CONFIG_PATH ends in /runtime/config.json, the manager derives
# the sibling /logs/access.log path.
DATAPLANE_ACCESS_LOG_PATH=
DATAPLANE_RESTART_COMMAND=
DATAPLANE_PROBE_HOST=127.0.0.1
# AI 节点纳管：可选远端 SSH 或本机 Docker。AI REALITY 凭据单独配置在 app/xray/.env。
AI_NODE_SSH_TARGET=
# 多台远端 AI 节点使用逗号或换行分隔；设置后每台节点在面板中独立显示。
AI_NODE_SSH_TARGETS=
AI_NODE_IDS=
AI_NODE_LABELS=
AI_NODE_SSH_OPTIONS=
AI_NODE_SSH_KNOWN_HOSTS=/root/.ssh/known_hosts_ai
AI_NODE_CONTAINER_NAME=xray-ai-node
AI_NODE_CONTAINER_NAMES=
AI_NODE_RESTART_COMMAND=
AI_NODE_RESTART_COMMANDS=
# 本机 Docker AI 备用使用控制面运行时目录挂载；留空以禁止面板通过 SSH 上传配置。
AI_NODE_CONFIG_PATH=
AI_NODE_CONFIG_PATHS=
AI_NODE_PROBE_HOST=
AI_NODE_PROBE_HOSTS=
AI_NODE_METRICS_URL=http://127.0.0.1:31097/debug/vars
AI_NODE_API_SERVERS=
AI_NODE_ACCESS_LOG_PATH=/app/xray/logs/ai-access.log
AI_NODE_DESTINATION_WINDOW_SECONDS=600
AI_NODE_DESTINATION_MAX_LABELS=50
# AI routing manager container used for an immediate manual node switch.
AI_DOMAIN_MANAGER_CONTAINER_NAME=xray-routing-panel-xray-ai-domain-manager-1
AI_DOMAIN_MANAGER_DOCKER_BIN=docker
# Optional operations attribution sampler. Stored samples use salted HMAC refs,
# never raw user emails, inbound tags, client IPs, or target domains.
OPS_XRAY_STATS_ENABLED=0
OPS_XRAY_STATS_SAMPLE_INTERVAL_SECONDS=300
OPS_XRAY_STATS_AI_ENABLED=0
OPS_XRAY_STATS_AI_SSH_TARGET=
OPS_XRAY_STATS_NORMAL_KNOWN_HOSTS_HOST_PATH=/root/.ssh/known_hosts
OPS_XRAY_STATS_AI_KNOWN_HOSTS_HOST_PATH=/root/.ssh/known_hosts_ai
OPS_XRAY_STATS_AI_CONTAINER=xray
OPS_XRAY_STATS_AI_METRICS_PORT=31097
# Daily reports read panel.db read-only for AI-domain history and Codex source/model.
OPS_PANEL_DB_HOST_DIR=./data
DNS_FAILOVER_ENABLED=0
DNS_FAILOVER_INTERVAL=15
DNS_FAILOVER_TIMEOUT=3
DNS_FAILOVER_FAILURE_THRESHOLD=3
DNS_FAILOVER_RECOVERY_THRESHOLD=2
DNS_FAILOVER_PROBE_HOST=
DNS_FAILOVER_PROBE_PORT=
CF_API_TOKEN=
CF_ZONE_ID=
CF_DNS_RECORD_ID=
CF_DNS_RECORD_TYPE=A
CF_DNS_RECORD_NAME=
CF_DNS_RECORD_PROXIED=0
CF_DNS_RECORD_TTL=60
# 留空时自动获取数据面公网 IP
DNS_FAILOVER_PRIMARY_CONTENT=
# 启用后，备用留空时自动使用控制面本机公网 IP，并配合备用 Xray 服务接管
CONTROL_PLANE_BACKUP_XRAY_ENABLED=0
# 留空时自动获取控制面本机公网 IP
DNS_FAILOVER_BACKUP_CONTENT=
DNS_FAILOVER_BACKUP_LABEL=控制面备用Xray
# 可选：在高峰窗口内优先切到备用/专用节点；窗口外恢复主节点优先。
DNS_FAILOVER_PEAK_ENABLED=0
DNS_FAILOVER_PEAK_START=19:00
DNS_FAILOVER_PEAK_END=23:00
# 可使用 IANA 时区名或 UTC 偏移，例如 America/Los_Angeles / +08:00
DNS_FAILOVER_PEAK_TIMEZONE=
# R2 disaster backups are enabled by default for the Compose backup service.
# Fill in the endpoint, credentials, and independent archive password before use.
DB_BACKUP_R2_ENABLED=1
DB_BACKUP_R2_ENDPOINT=https://0e016704dc5552d28010732c3d050a64.r2.cloudflarestorage.com
DB_BACKUP_R2_BUCKET=xray-routing-panel-disaster
DB_BACKUP_R2_ACCESS_KEY_ID=
DB_BACKUP_R2_SECRET_ACCESS_KEY=
DB_BACKUP_R2_REGION=auto
DB_BACKUP_R2_PREFIX=xray-routing-panel
# R2 upload record is stored beside local backups.
DB_BACKUP_R2_RECORD_PATH=/backups/r2-upload-record.json
# Daily encrypted disaster bundle. Paths are comma/newline separated and are
# stored under config/ in the archive; missing optional paths are skipped.
DB_BACKUP_BUNDLE_ENABLED=1
DB_BACKUP_BUNDLE_DIR=/backups
DB_BACKUP_BUNDLE_KEEP_DAYS=7
DB_BACKUP_BUNDLE_PREFIX=xray-routing-panel
# `1` makes an incomplete node recovery bundle fail the upload step. Keep `0`
# if a node outage must not interrupt the control-plane database backup.
DB_BACKUP_RECOVERY_REQUIRED=0
DB_BACKUP_RECOVERY_STATUS_PATH=/backups/node-recovery-status.json
# Optional secondary SQLite database; Compose mounts /srv/xray-ops read-only.
DB_BACKUP_OPS_DB_PATH=/ops-data/ops.db
# Daily disaster bundle. Keep this password separate from R2 credentials.
DB_BACKUP_ENCRYPTION_PASSWORD=
# Explicit allowlist. The resulting tar is mode 0600 and is encrypted with
# AES-256-GCM before upload.
DB_BACKUP_EXTRA_PATHS=/project/docker-compose.yml,/project/docker-compose.ops-reporting.yml,/project/docker-compose.ops-reporting.deploy.yml,/project/.env,/project/.env.ops-reporting,/project/.env.example,/project/k8s,/project/app/xray/.env,/project/app/xray/runtime,/project/app/xray/reports,/project/scripts,/data/uploads
# Read-only SSH collection of the actual files deployed on both data planes.
# Connections use the private network directly; no private key is mounted.
DB_BACKUP_SSH_COLLECTION_ENABLED=1
# Keep 0 so a node outage does not suppress the control-plane backup. Set 1
# only when a backup must fail unless the normal data-plane config is collected.
DB_BACKUP_SSH_COLLECTION_REQUIRED=0
DB_BACKUP_SSH_OPTIONS=
DB_BACKUP_SSH_TIMEOUT_SECONDS=20
DB_BACKUP_SSH_MAX_FILE_BYTES=5242880
DB_BACKUP_DATAPLANE_SSH_TARGET=root@100.116.187.106
DB_BACKUP_DATAPLANE_SSH_PORT=22
DB_BACKUP_DATAPLANE_KNOWN_HOSTS=/root/.ssh/known_hosts
# Normal data-plane host path (the running container sees this as /etc/xray/config.json).
DB_BACKUP_DATAPLANE_REMOTE_PATHS=/root/xray-routing-panel/app/xray/runtime/config.json,/root/xray-routing-panel/app/xray/.env,/root/xray-routing-panel/app/xray/runtime/panel-ports.json,/root/xray-routing-panel/app/xray/runtime/dynamic-routing.json,/root/xray-routing-panel/app/xray/runtime/client-test.json,/root/xray-routing-panel/app/xray/runtime/client-share.txt,/root/xray-routing-panel/app/xray/reports/hourly-domains/latest.json
DB_BACKUP_DATAPLANE_DEPLOY_ROOT=/root/xray-routing-panel
# Private-network SSH management endpoint; AI business traffic remains configured separately.
DB_BACKUP_AI_NODE_SSH_TARGET=
DB_BACKUP_AI_NODE_SSH_PORT=22
DB_BACKUP_AI_NODE_KNOWN_HOSTS=/root/.ssh/known_hosts_ai
DB_BACKUP_AI_NODE_REMOTE_PATHS=
DB_BACKUP_AI_NODE_DEPLOY_ROOT=/root/xray-routing-panel
